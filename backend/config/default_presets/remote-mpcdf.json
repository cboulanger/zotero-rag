{
  "version": 2,
  "description": "Fully remote via the MPCDF LLM Inference Service (llm.mpcdf.mpg.de) on your own MPCDF account. Log in with your MPCDF username, password and one-time code in Preferences, then start the endpoints; each runs as a job (up to 8 hours, renewed while in use) on your account.",
  "embedding": {
    "model_type": "remote",
    "model_name": "intfloat/multilingual-e5-large-instruct",
    "batch_size": 64,
    "provider": {"id": "mpcdf", "scope": "user", "options": {"gpus": 1, "idle_minutes": 60}},
    "model_kwargs": {}
  },
  "llm": {
    "model_type": "remote",
    "model_names": ["openai/gpt-oss-120b"],
    "max_context_length": 131072,
    "max_answer_tokens": 4096,
    "temperature": 0.7,
    "provider": {"id": "mpcdf", "scope": "user", "options": {"gpus": 2, "idle_minutes": 60}},
    "model_kwargs": {}
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.35,
    "max_chunk_size": 800
  },
  "memory_budget_gb": 0.5,
  "platform": "any"
}
