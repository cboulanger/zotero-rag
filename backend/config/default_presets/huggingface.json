{
  "version": 2,
  "description": "Fully remote via your own Hugging Face Inference Endpoints (embedding + LLM, pay-per-use, scale-to-zero, billed to your own Hugging Face account). Enter your Hugging Face token, then click \"Provision endpoint\" for each side to create or wake it.",
  "embedding": {
    "model_type": "remote",
    "model_name": "intfloat/multilingual-e5-large-instruct",
    "batch_size": 64,
    "model_kwargs": {
      "api_key_env": "HF_TOKEN"
    },
    "provider": {
      "id": "huggingface",
      "scope": "user",
      "options": {
        "vendor": "aws",
        "region": "eu-west-1",
        "engine": "tei",
        "instance": "nvidia-t4",
        "scale_to_zero_timeout_min": 15
      }
    }
  },
  "llm": {
    "model_type": "remote",
    "model_names": [
      "Qwen/Qwen2.5-7B-Instruct"
    ],
    "max_context_length": 32768,
    "max_answer_tokens": 2048,
    "temperature": 0.7,
    "model_kwargs": {
      "api_key_env": "HF_TOKEN"
    },
    "provider": {
      "id": "huggingface",
      "scope": "user",
      "options": {
        "vendor": "aws",
        "region": "eu-west-1",
        "engine": "vllm",
        "instance": "nvidia-a10g",
        "scale_to_zero_timeout_min": 15
      }
    }
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.35,
    "max_chunk_size": 800
  },
  "memory_budget_gb": 0.5,
  "platform": "any"
}
