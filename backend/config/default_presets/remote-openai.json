{
  "version": 2,
  "description": "Using OpenAI/Anthropic remote inference endpoints",
  "embedding": {
    "model_type": "remote",
    "model_name": "openai",
    "batch_size": 100
  },
  "llm": {
    "model_type": "remote",
    "model_names": ["gpt-4o-mini"],
    "max_context_length": 128000,
    "max_answer_tokens": 4096,
    "temperature": 0.7
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.5,
    "max_chunk_size": 1024
  },
  "memory_budget_gb": 1.0,
  "platform": "any"
}
