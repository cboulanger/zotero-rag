{
  "version": 2,
  "description": "Fully remote via the free test vendor, documents converted by its Docling service",
  "embedding": {
    "model_type": "remote",
    "model_name": "multilingual-e5-large-instruct",
    "batch_size": 256,
    "provider": {
      "id": "testvendor"
    },
    "model_kwargs": {
      "base_url": "https://testvendor.invalid/v1",
      "api_key_env": "TESTVENDOR_API_KEY"
    }
  },
  "llm": {
    "model_type": "remote",
    "model_names": [
      "test-llm-large",
      "test-llm-small"
    ],
    "max_context_length": 128000,
    "max_answer_tokens": 4096,
    "temperature": 0.7,
    "provider": {
      "id": "testvendor"
    },
    "model_kwargs": {
      "base_url": "https://testvendor.invalid/v1",
      "api_key_env": "TESTVENDOR_API_KEY"
    }
  },
  "extraction": {
    "backend": "docling",
    "options": {
      "api_flavor": "saia",
      "url": "https://testvendor.invalid",
      "api_key_env": "TESTVENDOR_API_KEY",
      "max_pages_per_request": 10
    }
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.35,
    "max_chunk_size": 800
  },
  "memory_budget_gb": 0.5,
  "platform": "any"
}
