{
  "version": 2,
  "description": "Test vendor embeddings with answers from the paid test service",
  "embedding": {
    "model_type": "remote",
    "model_name": "multilingual-e5-large-instruct",
    "batch_size": 256,
    "provider": {
      "id": "testvendor"
    },
    "model_kwargs": {
      "base_url": "https://testvendor.invalid/v1",
      "api_key_env": "TESTVENDOR_API_KEY"
    }
  },
  "llm": {
    "model_type": "remote",
    "model_names": [
      "other-llm"
    ],
    "max_context_length": 1000000,
    "max_answer_tokens": 4096,
    "temperature": 0.7,
    "provider": {
      "id": "testother"
    },
    "model_kwargs": {
      "base_url": "https://testother.invalid/v1",
      "api_key_env": "TESTOTHER_API_KEY"
    }
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.35,
    "max_chunk_size": 800
  },
  "memory_budget_gb": 0.5,
  "platform": "any"
}
