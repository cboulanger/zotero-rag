{
  "version": 2,
  "description": "Test vendor for embeddings and answers, with re-ranking in your own test session",
  "embedding": {
    "model_type": "remote",
    "model_name": "multilingual-e5-large-instruct",
    "batch_size": 256,
    "provider": {
      "id": "testvendor"
    },
    "model_kwargs": {
      "base_url": "https://testvendor.invalid/v1",
      "api_key_env": "TESTVENDOR_API_KEY"
    }
  },
  "llm": {
    "model_type": "remote",
    "model_names": [
      "test-llm-large",
      "test-llm-small"
    ],
    "max_context_length": 128000,
    "max_answer_tokens": 4096,
    "temperature": 0.7,
    "provider": {
      "id": "testvendor"
    },
    "model_kwargs": {
      "base_url": "https://testvendor.invalid/v1",
      "api_key_env": "TESTVENDOR_API_KEY"
    }
  },
  "rerank": {
    "model_type": "remote",
    "model_name": "BAAI/bge-reranker-v2-m3",
    "pool_size": 100,
    "provider": {
      "id": "testsession",
      "scope": "user"
    },
    "model_kwargs": {}
  },
  "rag": {
    "top_k": 10,
    "score_threshold": 0.35,
    "max_chunk_size": 800
  },
  "memory_budget_gb": 0.5,
  "platform": "any"
}
